<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.upn.arena.ClasificacionController"
      spacing="12" styleClass="pagina">

    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Clasificación" styleClass="titulo"/>
        <Button text="Actualizar tabla" onAction="#calcular"/>
    </HBox>

    <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colPos" text="#" prefWidth="45"/>
            <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="220"/>
            <TableColumn fx:id="colPJ" text="PJ" prefWidth="55"/>
            <TableColumn fx:id="colPG" text="PG" prefWidth="55"/>
            <TableColumn fx:id="colPE" text="PE" prefWidth="55"/>
            <TableColumn fx:id="colPP" text="PP" prefWidth="55"/>
            <TableColumn fx:id="colDif" text="Dif" prefWidth="60"/>
            <TableColumn fx:id="colPts" text="Pts" prefWidth="60"/>
        </columns>
    </TableView>
</VBox>
